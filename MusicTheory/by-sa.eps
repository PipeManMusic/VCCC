%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 88 31
%%Creator: Creative Commons / Daniel Worth
%%Title: CC BY-SA 4.0 Icon
%%Pages: 1
%%EndComments

gsave
0 setgray
1 setlinecap
1 setlinejoin

% --- Outer Border (Rounded Rectangle) ---
1 setlinewidth
newpath
  6 1 moveto
  82 1 lineto
  82 6 5 270 360 arc
  87 25 lineto
  82 25 5 0 90 arc
  6 30 lineto
  6 25 5 90 180 arc
  1 6 lineto
  6 6 5 180 270 arc
closepath
stroke

% --- Circle 1: CC Logo ---
1.8 setlinewidth
newpath 16 15.5 10 0 360 arc stroke

% Two 'C' Glyphs
2 setlinewidth
newpath 13.5 15.5 4.2 45 315 arc stroke
newpath 19.5 15.5 4.2 45 315 arc stroke

% --- Circle 2: BY (Attribution Figure) ---
1.8 setlinewidth
newpath 44 15.5 10 0 360 arc stroke

% Head
newpath 44 20.8 2.2 0 360 arc fill

% Body Silhouette
newpath
  41.2 9.0 moveto
  41.2 14.5 lineto
  40.5 14.5 lineto
  41.5 17.5 lineto
  46.5 17.5 lineto
  47.5 14.5 lineto
  46.8 14.5 lineto
  46.8 9.0 lineto
  44.8 9.0 lineto
  44.8 12.0 lineto
  43.2 12.0 lineto
  43.2 9.0 lineto
closepath
fill

% --- Circle 3: SA (ShareAlike Circular Arrow) ---
1.8 setlinewidth
newpath 72 15.5 10 0 360 arc stroke

% Circular Arc
2 setlinewidth
newpath 72 15.5 5.2 55 315 arc stroke

% Arrowhead
newpath
  77.2 13.3 moveto
  73.8 12.2 lineto
  76.2 9.8 lineto
closepath
fill

grestore
%%EOF